# Template for local development environment variables.
#
# Copy to .env (which git ignores) and fill in values:
#   cp .env.example .env && chmod 600 .env
#
# The dotenv gem loads .env into every bin/rails command in development only.
# Never put real values in this file — it is committed. Production values live in
# the Render dashboard instead (see render.yaml, sync: false).

# Creates (or promotes) an admin login when you run `bin/rails db:seed`. See db/seeds.rb.
# Use a development-only password (15+ characters), not your production one.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

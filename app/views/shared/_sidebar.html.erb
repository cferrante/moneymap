<%# 240px persistent nav. `active` is matched on controller_path so a nested page
    (editing a budget, revoking a session) keeps its section highlighted. %>
<%# Flag-gated sections are dropped from the nav entirely rather than shown and
    404ing on click. `feature` is the flag key; an entry without one is always on. %>
<% nav = [
     { label: "Dashboard",    path: dashboard_path,    icon: "house",        controllers: %w[ dashboard home ], feature: :dashboard },
     { label: "Transactions", path: transactions_path, icon: "receipt",      controllers: %w[ transactions transfers ] },
     { label: "Budgets",      path: budgets_path,      icon: "wallet",       controllers: %w[ budgets ], feature: :budgets },
     { label: "Reports",      path: reports_path,      icon: "chart-column", controllers: %w[ reports ], feature: :reports }
   ].select { |item| item[:feature].nil? || feature_enabled?(item[:feature]) }
   manage = [
     { label: "Accounts",   path: accounts_path,   icon: "landmark", controllers: %w[ accounts ] },
     { label: "Categories", path: categories_path, icon: "layers",   controllers: %w[ categories ] }
   ]
   admin = [
     { label: "Feature flags", path: admin_feature_flags_path, icon: "flag", controllers: %w[ admin/feature_flags admin/feature_flag_assignments ] },
     { label: "Invitations",   path: admin_invitations_path,   icon: "mail-plus", controllers: %w[ admin/invitations ], feature: :invitations }
   ].select { |item| item[:feature].nil? || feature_enabled?(item[:feature]) }
   settings_active = %w[ settings user_sessions ].include?(controller_path) %>

<aside class="w-60 shrink-0 bg-white border-r border-gray-200 py-6 px-4 flex flex-col gap-7">
  <%= render "shared/brand" %>

  <nav class="flex flex-col gap-0.5" aria-label="Main">
    <% nav.each do |item| %>
      <%= render "shared/nav_item", item: item %>
    <% end %>
  </nav>

  <div class="flex flex-col gap-0.5">
    <span class="<%= eyebrow_classes %> px-3 pb-1.5">Manage</span>
    <% manage.each do |item| %>
      <%= render "shared/nav_item", item: item %>
    <% end %>
  </div>

  <%# Admin is app-wide rather than one user's own data, so it gets its own group
      instead of sitting alongside Accounts and Categories. %>
  <% if Current.user.admin? %>
    <div class="flex flex-col gap-0.5">
      <span class="<%= eyebrow_classes %> px-3 pb-1.5">Admin</span>
      <% admin.each do |item| %>
        <%= render "shared/nav_item", item: item %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-auto flex items-center gap-2.5 pt-3 px-2 border-t border-gray-200">
    <span class="size-8 rounded-full bg-mint flex items-center justify-center font-bold text-deep-green text-[13px] shrink-0">
      <%= Current.user.email_address.first.upcase %>
    </span>
    <span class="flex flex-col leading-tight min-w-0 flex-1">
      <span class="text-[13px] font-semibold text-green-black truncate" title="<%= Current.user.email_address %>">
        <%= Current.user.email_address.split("@").first.titleize %>
      </span>
      <span class="text-[11px] text-gray-500">Personal · USD</span>
    </span>
    <%# The design's footer gear, wired to the settings page main added. Both
        actions are one click rather than behind a dropdown. %>
    <%= link_to edit_settings_path,
          class: class_names("p-1.5 rounded-lg shrink-0", settings_active ? "bg-mint text-deep-green" : "text-gray-500 hover:text-green-black hover:bg-gray-50"),
          title: "Settings", aria: { label: "Settings" } do %>
      <%= icon "settings", class: "size-4" %>
    <% end %>
    <%= button_to session_path, method: :delete,
          class: "p-1.5 rounded-lg shrink-0 text-gray-500 hover:text-green-black hover:bg-gray-50 cursor-pointer",
          title: "Log out", aria: { label: "Log out" } do %>
      <%= icon "log-out", class: "size-4" %>
    <% end %>
  </div>
</aside>
